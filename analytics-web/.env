# Browse this app at http://analytics.localhost:5273 — the IdP redirect URI is an exact match.
VITE_API_BASE=http://api.localhost:5000
VITE_AUTH_AUTHORITY=http://auth.localhost:5100
# The IdP seeds this client as "analytics-web" (AuthDbInitialiser); the code default is "report-web".
VITE_AUTH_CLIENT_ID=analytics-web
VITE_AUTH_SCOPE=openid profile email roles ceo.api

# Mock mode: the app runs without the IdP or the API. Set both to real values below to go live —
# the analytics-web OIDC client is now registered locally, so real sign-in works.
VITE_AUTH_MODE=mock
VITE_USE_MOCK_API=true
VITE_AI_MODE=mock
