FROM node:24-alpine AS build
WORKDIR /app
COPY portal-web/package.json ./package.json
RUN npm install --no-audit --no-fund
COPY portal-web/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY portal-web/deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
