# syntax=docker/dockerfile:1
# room-web SPA -> static nginx. Build context = monorepo root (deploy/docker-compose.newserver.yml).
FROM node:24-alpine AS build
WORKDIR /app/room-web

ARG VITE_API_BASE=https://api.myceo.ir
ARG VITE_AUTH_AUTHORITY=https://auth.myceo.ir
ARG VITE_AUTH_CLIENT_ID=room-web
ARG VITE_AUTH_SCOPE="openid profile email roles ceo.api"
ENV VITE_API_BASE=$VITE_API_BASE \
    VITE_AUTH_AUTHORITY=$VITE_AUTH_AUTHORITY \
    VITE_AUTH_CLIENT_ID=$VITE_AUTH_CLIENT_ID \
    VITE_AUTH_SCOPE=$VITE_AUTH_SCOPE

COPY room-web/package.json ./
# --legacy-peer-deps: antd-jalali declares React 18 and this app is on React 19. Same as election-web
# and walfare-web; without it the image build fails outright at npm install. See GOTCHAS.
RUN npm install --legacy-peer-deps

COPY room-web/ ./
RUN npm run build

FROM nginx:1.27-alpine AS runtime
RUN rm -rf /usr/share/nginx/html/*
COPY --from=build /app/room-web/dist /usr/share/nginx/html
COPY room-web/deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1
CMD ["nginx", "-g", "daemon off;"]
