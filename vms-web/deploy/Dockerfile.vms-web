# syntax=docker/dockerfile:1
# vms-web SPA -> static nginx. Build context = monorepo root (deploy/docker-compose.newserver.yml).
FROM node:24-alpine AS build
WORKDIR /app/vms-web

ARG VITE_API_BASE=https://api.myceo.ir
ARG VITE_AUTH_AUTHORITY=https://auth.myceo.ir
ARG VITE_AUTH_CLIENT_ID=vms-web
ARG VITE_AUTH_SCOPE="openid profile email roles ceo.api"
# The media gateway, and it is NOT this API and NOT this origin — video never touches the main box.
# Wrong or missing here means every tile fails to connect with nothing on screen to say why.
ARG VITE_MEDIA_BASE=https://cam.myceo.ir
ENV VITE_API_BASE=$VITE_API_BASE \
    VITE_AUTH_AUTHORITY=$VITE_AUTH_AUTHORITY \
    VITE_AUTH_CLIENT_ID=$VITE_AUTH_CLIENT_ID \
    VITE_AUTH_SCOPE=$VITE_AUTH_SCOPE \
    VITE_MEDIA_BASE=$VITE_MEDIA_BASE

COPY vms-web/package.json ./
# No --legacy-peer-deps here, unlike election-web and walfare-web: this app has no antd-jalali (it
# takes no dates), so nothing declares React 18 against this React 19 tree.
RUN npm install

COPY vms-web/ ./
RUN npm run build

FROM nginx:1.27-alpine AS runtime
RUN rm -rf /usr/share/nginx/html/*
COPY --from=build /app/vms-web/dist /usr/share/nginx/html
COPY vms-web/deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1
CMD ["nginx", "-g", "daemon off;"]
