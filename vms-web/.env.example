# vms-web — build-time config (Vite inlines every VITE_* into dist/).
# PUBLIC values only: a static SPA bundle has no server side, so real secrets never belong here.

# Central OIDC IdP (OpenIddict). Dev runs `dotnet run --project src/Auth` on :5100.
VITE_AUTH_AUTHORITY=http://auth.localhost:5100

# Public PKCE client registered on the IdP for this panel.
VITE_AUTH_CLIENT_ID=vms-web

# Optional — defaults to "openid profile email roles ceo.api".
VITE_AUTH_SCOPE=openid profile email roles ceo.api

# Backend API (camera routes live under ${VITE_API_BASE}/api/VmsAdmin and /api/VmsMedia).
VITE_API_BASE=http://api.localhost:5000

# The media gateway — go2rtc behind Traefik on the VPS. NOT this API and NOT this origin: video
# never touches the main box. Cross-origin on purpose, which is why the media cookie is scoped to
# the parent domain rather than to one host.
VITE_MEDIA_BASE=https://cam.myceo.ir